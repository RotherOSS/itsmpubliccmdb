<?xml version="1.0" encoding="utf-8" ?>
<otobo_config version="2.0" init="Framework">

    <!-- Public ITSM Config Items related settings -->
    
    <Setting Name="AutoComplete::Public###Default" Required="0" Valid="1">
        <Description Translatable="1">Defines the config options for the autocompletion feature.</Description>
        <Navigation>Frontend::Public</Navigation>
        <Value>
            <Hash>
                <Item Key="AutoCompleteActive">1</Item>
                <Item Key="MinQueryLength">2</Item>
                <Item Key="QueryDelay">100</Item>
                <Item Key="MaxResultsDisplayed">20</Item>
                <Item Key="ButtonText" Translatable="1">Search</Item>
            </Hash>
        </Value>
    </Setting>

    <Setting Name="PublicPanelSessionName" Required="1" Valid="1">
        <Description Translatable="1">Defines the name of the key for public sessions.</Description>
        <Navigation>Core::Session</Navigation>
        <Value>
            <Item ValueType="String" ValueRegex="">OTOBOPublicInterface</Item>
        </Value>
    </Setting>

    <Setting Name="PublicColorDefinitions" Required="1" Valid="1">
        <Description Translatable="1">Color definitions for the public interface.</Description>
        <Navigation>Frontend::Public</Navigation>
        <Value>
            <Hash>
                <Item Key="MainDark">#00023c</Item>
                <Item Key="MainLight">#001bff</Item>
                <Item Key="MainHover">#000099</Item>
                <Item Key="BGLight">#f7f7f9</Item>
                <Item Key="BGDark">#bfbfce</Item>
                <Item Key="TextDark">#00023c</Item>
                <Item Key="TextLight">#7f809d</Item>
                <Item Key="Highlight">#fef235</Item>
                <Item Key="NotifyOK">#c4cdfa</Item>
                <Item Key="NotifyWarn">#fffccc</Item>
                <Item Key="NotifyErr">#f9bcb2</Item>
                <Item Key="HoverLight">#c4cdfa</Item>
                <Item Key="HoverDark">#6d83f2</Item>
                <Item Key="ShadowMain">rgba(0,27,255,0.24)</Item>
                <Item Key="ShadowDark">rgba(4,0,71,0.16)</Item>
            </Hash>
        </Value>
    </Setting>

   <Setting Name="PublicSkinColorDefinition::highcontrast" Required="1" Valid="1">
        <Description Translatable="1">Color definitions for Public Interface highcontrast skin.</Description>
        <Navigation>Frontend::Public</Navigation>
        <Value>
            <Hash>
                <Item Key="MainDark">#333</Item>
                <Item Key="MainLight">#001bff</Item>
                <Item Key="BGLight">#ffffff</Item>
                <Item Key="BGDark">#000000</Item>
                <Item Key="TextDark">#000000</Item>
                <Item Key="TextLight">#ffffff</Item>
                <Item Key="Highlight">#ffffff</Item>
                <Item Key="NotifyOK">#e0e0e0</Item>
                <Item Key="NotifyWarn">#fffccc</Item>
                <Item Key="NotifyErr">#f9bcb2</Item>
                <Item Key="HoverLight">#e0e0e0</Item>
                <Item Key="HoverDark">#b5b5b5</Item>
                <Item Key="ShadowMain">rgba(0,27,255,0.24)</Item>
                <Item Key="ShadowDark">rgba(4,0,71,0.16)</Item>
            </Hash>
        </Value>
    </Setting>

</otobo_config>
